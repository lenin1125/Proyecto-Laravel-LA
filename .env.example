APP_NAME="Hotel Consumos API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hotel-consumos-api.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_consumos_api
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# URL base del servidor SOAP en PHP nativo.
# Valor solicitado originalmente (no usar mientras Docker/WSL intercepte localhost):
# SOAP_SERVICE_URL=http://localhost/hotel/server.php
# En este equipo se usa 127.0.0.1 porque Docker/WSL intercepta localhost:80.
SOAP_SERVICE_URL=http://127.0.0.1/hotel/server.php


# Base de datos del proyecto SOAP donde se replica el usuario y el token.
SOAP_DB_DATABASE=hotel_db

# Tiempo maximo de espera de las llamadas SOAP en segundos.
SOAP_TIMEOUT=15

# Seguridad de la API.
# Minutos de vigencia del token Bearer (480 = 8 horas).
SANCTUM_EXPIRATION=480
# Intentos de login permitidos por correo e IP dentro de la ventana.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=1
